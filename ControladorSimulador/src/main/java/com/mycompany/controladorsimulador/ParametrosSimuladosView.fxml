<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="800.0" prefWidth="700.0" spacing="10.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="yourpackage.ParametrosSimuladosController">
   <children>
      <Label text="Parámetros Simulados" />
      
      <Label text="Corriente:" />
      <TextField fx:id="corrienteField" promptText="Ingrese corriente (double)" />
      
      <Label text="Voltaje:" />
      <TextField fx:id="voltajeField" promptText="Ingrese voltaje (double)" />
      
      <Label text="Tiempo de Electrólisis:" />
      <TextField fx:id="tiempoElectrolisisField" promptText="Ingrese tiempo (double)" />
      
      <Label text="Eficiencia Farádica:" />
      <TextField fx:id="eficienciaFaradicaField" promptText="Ingrese eficiencia (double)" />
      
      <Label text="Temperatura:" />
      <TextField fx:id="temperaturaField" promptText="Ingrese temperatura (double)" />
      
      <Label text="Factor CO2:" />
      <TextField fx:id="factorCO2Field" promptText="Ingrese factor CO2 (double)" />
      
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button fx:id="validarButton" onAction="#validarParametros" text="Validar" />
            <Button fx:id="actualizarButton" onAction="#actualizarParametros" text="Actualizar" />
            <Button fx:id="obtenerButton" onAction="#obtenerParametros" text="Obtener" />
         </children>
      </HBox>
      <AreaChart fx:id="graficoarea" titleSide="LEFT">
        <xAxis>
          <NumberAxis side="BOTTOM" />
        </xAxis>
        <yAxis>
          <NumberAxis side="LEFT" />
        </yAxis>
      </AreaChart>
   </children>
</VBox>
